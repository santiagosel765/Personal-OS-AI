// Personal OS AI — esquema inicial Fase 2.
// Todas las cifras de dinero en Decimal(14,2). Moneda por entidad para multi-currency futuro.
// Toda entidad lleva createdAt/updatedAt. EventLog absorbe el event sourcing inicial.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── ENUMS ─────────────────────────

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT
  INVESTMENT
  EMERGENCY
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT_PAYMENT
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum DebtStatus {
  ACTIVE
  PAID
  FROZEN
  IN_DEFAULT
}

enum CardStatus {
  ACTIVE
  BLOCKED
  PENDING_CANCELLATION
  CANCELLED
  FROZEN
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventType {
  PLANNED
  SUDDEN
  RECURRING
}

// ───────────────────────── MODELS ─────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String?
  currency       String   @default("GTQ")
  timezone       String   @default("America/Guatemala")
  monthlyIncome  Decimal  @default(0) @db.Decimal(14, 2)
  weeklyBudget   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  debts        Debt[]
  cards        Card[]
  goals        Goal[]
  events       Event[]
  logs         EventLog[]

  @@map("users")
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  bank           String?
  type           AccountType
  currency       String      @default("GTQ")
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  currentBalance Decimal     @default(0) @db.Decimal(14, 2)
  purpose        String?
  isReserved     Boolean     @default(false)
  isActive       Boolean     @default(true)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[] @relation("TxAccountFrom")
  incomingTransactions  Transaction[] @relation("TxAccountTo")

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  type      CategoryType
  color     String?
  icon      String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  accountId       String
  accountToId     String?
  categoryId      String?
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @default("GTQ")
  date            DateTime
  description     String
  rawDescription  String?
  paymentMethod   PaymentMethod?
  merchant        String?
  person          String?
  isNecessary     Boolean?
  isImpulsive     Boolean?
  classifiedByAi  Boolean         @default(false)
  aiConfidence    Float?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account   @relation("TxAccountFrom", fields: [accountId], references: [id])
  accountTo Account?  @relation("TxAccountTo", fields: [accountToId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([accountId])
  @@map("transactions")
}

model Debt {
  id                  String     @id @default(cuid())
  userId              String
  institution         String
  name                String
  type                String
  initialAmount       Decimal    @db.Decimal(14, 2)
  currentBalance      Decimal    @db.Decimal(14, 2)
  interestRate        Decimal    @default(0) @db.Decimal(6, 2)
  monthlyPayment      Decimal    @db.Decimal(14, 2)
  paymentDay          Int?
  totalMonths         Int?
  remainingMonths     Int?
  allowsCapitalPayment Boolean   @default(false)
  capitalPaymentFrom  Int?
  status              DebtStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("debts")
}

model Card {
  id                String     @id @default(cuid())
  userId            String
  bank              String
  name              String
  status            CardStatus @default(ACTIVE)
  creditLimit       Decimal?   @db.Decimal(14, 2)
  currentBalance    Decimal    @default(0) @db.Decimal(14, 2)
  revolvingBalance  Decimal?   @db.Decimal(14, 2)
  principalBalance  Decimal?   @db.Decimal(14, 2)
  minimumPayment    Decimal?   @db.Decimal(14, 2)
  statementBalance  Decimal?   @db.Decimal(14, 2)
  cutDate           Int?
  paymentDate       Int?
  actionRequired    String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cards")
}

model Goal {
  id            String       @id @default(cuid())
  userId        String
  name          String
  category      String
  targetAmount  Decimal      @db.Decimal(14, 2)
  currentAmount Decimal      @default(0) @db.Decimal(14, 2)
  targetDate    DateTime?
  priority      GoalPriority @default(MEDIUM)
  status        GoalStatus   @default(ACTIVE)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model Event {
  id               String    @id @default(cuid())
  userId           String
  name             String
  type             EventType
  startDate        DateTime
  endDate          DateTime?
  estimatedBudget  Decimal?  @db.Decimal(14, 2)
  actualSpent      Decimal?  @db.Decimal(14, 2)
  location         String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("events")
}

model EventLog {
  id         String   @id @default(cuid())
  userId     String?
  eventType  String
  entityType String
  entityId   String?
  payload    Json
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("event_logs")
}
