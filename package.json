{
  "name": "personal-os",
  "version": "0.1.0",
  "private": true,
  "description": "Personal OS AI — sistema operativo personal con IA (finanzas → salud → agente)",
  "scripts": {
    "dev": "turbo run dev --filter=@personal-os/api --filter=@personal-os/web",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @personal-os/db generate",
    "db:migrate": "pnpm --filter @personal-os/db migrate",
    "db:seed": "pnpm --filter @personal-os/db seed",
    "db:studio": "pnpm --filter @personal-os/db studio",
    "demo:dev": "pnpm --filter vite-demo dev",
    "demo:build": "pnpm --filter vite-demo build"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@google/genai",
      "protobufjs"
    ]
  }
}
