# -------- Base de datos --------
# PostgreSQL 16+ (también funciona con 18). Ajusta usuario/clave/db.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_os_dev?schema=public"

# -------- Auth (uso futuro, no implementado en Fase 2) --------
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"

# -------- Backend (apps/api) --------
API_PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# -------- IA (SOLO BACKEND, nunca exponer en frontend) --------
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# -------- Frontend (apps/web) --------
# URL pública del API. Solo esta variable es segura para el cliente.
NEXT_PUBLIC_API_URL="http://localhost:3001"
